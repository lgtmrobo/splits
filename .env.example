# ============================================================
# Splits — Environment Variables
# ============================================================
# Copy to .env.local and fill in, then run `pnpm check-env` to verify.
# Production needs everything not marked optional (and never DEV_AUTH_BYPASS).

# ---- Supabase ----
# From your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Strava ----
# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string — used by Strava to verify your webhook subscription.
# Generate with: openssl rand -hex 16
STRAVA_WEBHOOK_VERIFY_TOKEN=

# ---- WHOOP (optional, recommended) ----
# From https://developer-dashboard.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# ---- Anthropic (optional — AI run analysis, not wired into the UI yet) ----
# From https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- Mapbox (optional, recommended — route maps + heatmap) ----
# From https://account.mapbox.com → Tokens. A default public token works.
# Lock it to your prod URL via URL restrictions in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---- App ----
# Used for OAuth redirect URIs and webhook callback URL.
# Local: http://localhost:3000 — prod: https://splits.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Checked in /api/cron/* handlers. Vercel Cron sends this as a Bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Google emails allowed to sign in, comma-separated. The FIRST one is the
# owner: their Strava connect imports the last 2 years of runs. Everyone
# else only gets activities from the moment they connect. Anyone not listed
# is bounced at login. (ALLOWED_EMAIL, singular, still works.)
ALLOWED_EMAILS=you@gmail.com

# Athlete's timezone (used to compute "today" correctly when the server runs in UTC).
# IANA TZ name, e.g. America/Los_Angeles, America/New_York, Europe/London.
APP_TIMEZONE=America/Los_Angeles

# ---- Dev only ----
# Set to "true" locally to skip Google login and use the service-role
# Supabase client. NEVER set in production.
DEV_AUTH_BYPASS=

# ---- COROS (optional, personal script only) ----
# Used by scripts/coros-push.mjs to push planned runs to the COROS Training
# Hub calendar via its unofficial API. Not used by the app.
COROS_EMAIL=
COROS_PASSWORD=
COROS_REGION=us
